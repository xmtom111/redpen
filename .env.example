# Copy to .env and fill in. Any OpenAI-compatible endpoint works (see README).
REDPEN_API_KEY=
REDPEN_BASE_URL=https://api.openai.com/v1
# Use the strongest reasoning model you have: answer-key quality depends on it.
REDPEN_MODEL=

# Optional: a different model for `submit --ai`
# REDPEN_HUNTER_MODEL=
# Optional: worksheet language (default: the language of your topic)
# REDPEN_LANGUAGE=English
# Optional: where sessions are stored (default: ./sessions)
# REDPEN_HOME=
